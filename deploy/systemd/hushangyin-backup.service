[Unit]
Description=Hushangyin authenticated encrypted online SQLite backup
[Service]
Type=oneshot
User=hushangyin
Group=hushangyin
WorkingDirectory=/opt/hushangyin/current
EnvironmentFile=/etc/hushangyin/backup.env
ExecStart=/usr/bin/node scripts/sqlite-backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hushangyin /var/backups/hushangyin
MemoryMax=384M
StandardOutput=journal
StandardError=journal
