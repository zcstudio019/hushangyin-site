[Unit]
Description=Hushangyin single SQLite content worker
After=hushangyin-web.service
[Service]
Type=simple
User=hushangyin
Group=hushangyin
WorkingDirectory=/opt/hushangyin/current
# Node path: /etc/hushangyin/runtime.env, read by run-runtime.sh
EnvironmentFile=/etc/hushangyin/app.env
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecCondition=/bin/bash /opt/hushangyin/current/deploy/ecs/run-runtime.sh node -e "process.exit(process.env.GEO_WORKER_ENABLED==='true'?0:1)"
ExecStart=/bin/bash /opt/hushangyin/current/deploy/ecs/run-runtime.sh node --conditions=react-server --import tsx scripts/geo-generation-worker.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hushangyin
InaccessiblePaths=-/etc/hushangyin/backup.key -/etc/hushangyin/ossutil.conf -/var/backups/hushangyin
MemoryHigh=256M
MemoryMax=384M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hushangyin-worker
[Install]
WantedBy=multi-user.target
