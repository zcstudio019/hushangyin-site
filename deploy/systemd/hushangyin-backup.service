[Unit]
Description=Hushangyin authenticated encrypted online SQLite backup
[Service]
Type=oneshot
User=hushangyin
Group=hushangyin
WorkingDirectory=/opt/hushangyin/current
# Node path: /etc/hushangyin/runtime.env, read by run-runtime.sh
EnvironmentFile=/etc/hushangyin/backup.env
ExecStart=/bin/bash /opt/hushangyin/current/deploy/ecs/run-runtime.sh node scripts/sqlite-backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hushangyin /var/backups/hushangyin
MemoryMax=256M
StandardOutput=journal
StandardError=journal
