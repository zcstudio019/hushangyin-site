# /etc/hushangyin/backup.env, root:hushangyin 0640. Key file: hushangyin 0600, raw 32 bytes.
DATABASE_URL=file:/var/lib/hushangyin/production.sqlite
SQLITE_BACKUP_DIR=/var/backups/hushangyin
BACKUP_ENCRYPTION_KEY_FILE=/etc/hushangyin/backup.key
BACKUP_RETENTION_DAYS=30
OSS_BACKUP_ENABLED=false
OSS_BACKUP_DESTINATION=
