# Local development only. Never commit a populated .env file.
DATABASE_URL=
# Production must be the real HTTPS origin; no placeholder domain.
SITE_URL=http://127.0.0.1:3000
# At least 32 random characters each, generated separately.
SESSION_SECRET=
RATE_LIMIT_SECRET=
# Enable only when a trusted reverse proxy REPLACES x-forwarded-for.
TRUST_PROXY=false
# Explicit operational opt-in after privacy notice and retention are reviewed.
CONSULTATIONS_ENABLED=false
LOCAL_TEST_MODE=false
# Separate local database ending in _test; never point tests at a real customer database.
TEST_DATABASE_URL=
# Administrator bootstrap reads process env, never a source-code default.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# V1.5.3 AI: copy these AI settings to ignored .env.local; enter your own gateway key there.
# Both Next.js and Worker load .env then .env.local; system environment retains precedence.
# Never use NEXT_PUBLIC_ for credentials. No model requests occur when AI_API_KEY is blank.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://maimai.it.com/v1
AI_MODEL=gpt-6-sol
AI_API_KEY=
AI_REASONING_EFFORT=medium
# Legacy OPENAI_API_KEY is accepted only for older provider modes when AI_API_KEY is undefined.
# openai-compatible never silently reuses an OpenAI key; explicit blank always prevents fallback.
# openai-compatible / compatible-chat -> /chat/completions; openai-responses -> /responses.
# Leave generation disabled in production until separately authorized.
AI_GENERATION_ENABLED=false
AI_EXTERNAL_TRANSMISSION_APPROVED=false
# Gateway parameter support must be confirmed after the user adds a key; no automatic model/parameter fallback.
AI_CHAT_TOKEN_PARAMETER=max_completion_tokens
AI_CHAT_RESPONSE_FORMAT=json_schema
AI_TIMEOUT_MS=90000
AI_MAX_OUTPUT_TOKENS=4000
# Optional gateway USD prices per million tokens. Blank means unavailable, not free.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

# 第一方匿名分析：默认关闭；本地测试需显式启用，生产另行批准且HTTPS。
ANALYTICS_ENABLED=false
ANALYTICS_PRODUCTION_APPROVED=false
ANALYTICS_MAINTENANCE_APPROVED=false

# V1.6: keep PostgreSQL as the unchanged local default.
DATABASE_PROVIDER=postgresql
SQLITE_DATABASE_URL=
# Future independent MySQL database only; no RDS connection by default.
MYSQL_DATABASE_URL=
MYSQL_PRODUCTION_APPROVED=false
MYSQL_LOCAL_TEST_MODE=false
PRODUCTION_CONSULTATIONS_APPROVED=false
GEO_WORKER_ENABLED=false
