{
  "name": "hushangyin-platform",
  "version": "1.5.3",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/start-platform.mjs --dev",
    "build": "npm run db:generate:all && next build --webpack",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/start-platform.mjs",
    "test:consultation": "node --env-file=.env tests/v102/actual-service.cjs",
    "test:rbac": "node --env-file=.env tests/v103/account-rbac.cjs",
    "test:geo": "node --env-file=.env tests/v151/geo-e2e.cjs",
    "test:geo-import": "node --env-file=.env tests/v152/import-e2e.cjs",
    "geo:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate-geo-content.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests/v1 tests/v101 tests/v102 tests/v103 tests/v151 tests/v152 tests/v153 --max-warnings 0 tests/review-fix tests/review-permission tests/independent-reviewer tests/faq-approval tests/review-risk tests/ai-config tests/ai-entry tests/article-version tests/fact-check tests/analytics tests/analytics-acceptance tests/v16",
    "db:local": "node scripts/local-postgres.mjs",
    "test:integration": "node --env-file=.env tests/v101/database-e2e.cjs",
    "format": "prettier --write src scripts/*.ts tests/v1/*.ts *.ts *.mjs",
    "test": "node --env-file-if-exists=.env --conditions=react-server --import tsx --test tests/v1/*.test.ts",
    "test:browser": "node tests/v1/browser.cjs",
    "test:form": "node tests/v1/form.cjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed-content.ts",
    "worker:geo": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/geo-generation-worker.ts",
    "generation:seed": "node --env-file-if-exists=.env --import tsx scripts/seed-generation.ts",
    "test:generation": "node --env-file-if-exists=.env --conditions=react-server --import tsx --test tests/v153/generation.test.ts",
    "test:generation:browser": "node --env-file=.env tests/v153/browser.cjs",
    "test:reviews": "node --env-file=.env tests/review-fix/browser.cjs",
    "test:review-permission": "node --env-file=.env tests/review-permission/browser.cjs",
    "test:independent-reviewer": "node --env-file=.env tests/review-permission/browser.cjs --existing-grant",
    "test:faq-approval": "node --env-file=.env tests/faq-approval/browser.cjs",
    "test:review-risk": "node --env-file=.env tests/review-risk/browser.cjs",
    "test:ai-config": "node --env-file=.env tests/ai-config/browser.cjs",
    "test:ai-entry": "node --env-file=.env tests/ai-entry/browser.cjs",
    "test:article-version": "node --env-file=.env tests/article-version/browser.cjs",
    "test:fact-check": "node --env-file=.env tests/fact-check/browser.cjs",
    "analytics:maintenance": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/analytics-maintenance.ts",
    "backup:analytics": "node --env-file-if-exists=.env scripts/backup-analytics.mjs",
    "test:analytics": "node --env-file-if-exists=.env --conditions=react-server --import tsx --test tests/analytics/*.test.ts",
    "test:analytics:browser": "node --env-file=.env tests/analytics/browser.cjs",
    "test:analytics:acceptance": "node --env-file=.env --env-file-if-exists=.env.local tests/analytics-acceptance/browser.cjs",
    "analytics:cleanup-acceptance": "node --env-file=.env --env-file-if-exists=.env.local scripts/cleanup-analytics-acceptance.mjs",
    "db:generate:all": "node scripts/prepare-db-schemas.mjs && node scripts/db-tool.mjs generate all",
    "db:validate:all": "node scripts/db-tool.mjs validate all",
    "db:deploy:provider": "node scripts/db-tool.mjs deploy",
    "test:sqlite:generation": "node --env-file=.local-postgres/v16/workflow.env --conditions=react-server --import tsx --test tests/v153/generation.test.ts",
    "test:sqlite:concurrency": "node --env-file=.local-postgres/v16/stage.env --conditions=react-server --import tsx tests/v16/concurrency.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@prisma/client": "6.19.3",
    "iron-session": "9.0.1",
    "@node-rs/argon2": "2.2.2",
    "zod": "4.6.7",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "tsx": "4.23.15"
  }
}
