# Private SSH-tunnel testing only; no public Nginx/DNS. Copy to app.env only for the isolated preview database.
NODE_ENV=production
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:/var/lib/hushangyin/preview.sqlite
SQLITE_DATABASE_URL=file:/var/lib/hushangyin/preview.sqlite
SITE_URL=http://127.0.0.1:3120
PORT=3120
LOCAL_TEST_MODE=true
SESSION_SECRET=
RATE_LIMIT_SECRET=
TRUST_PROXY=false
CONSULTATIONS_ENABLED=true
PRODUCTION_CONSULTATIONS_APPROVED=false
ANALYTICS_ENABLED=true
ANALYTICS_PRODUCTION_APPROVED=false
AI_GENERATION_ENABLED=false
AI_EXTERNAL_TRANSMISSION_APPROVED=false
GEO_WORKER_ENABLED=false
AI_API_KEY=
