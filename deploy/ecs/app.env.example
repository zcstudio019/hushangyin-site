# Copy manually to /etc/hushangyin/app.env, owner root:hushangyin, mode 0640.
# Node 24 LTS. No real secret belongs in this repository.
NODE_ENV=production
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:/var/lib/hushangyin/production.sqlite
SQLITE_DATABASE_URL=file:/var/lib/hushangyin/production.sqlite
SITE_URL=https://hushangyin.linhongtech.com
PORT=3120
LOCAL_TEST_MODE=false
SESSION_SECRET=
RATE_LIMIT_SECRET=
TRUST_PROXY=true
CONSULTATIONS_ENABLED=false
PRODUCTION_CONSULTATIONS_APPROVED=false
ANALYTICS_ENABLED=false
ANALYTICS_PRODUCTION_APPROVED=false
ANALYTICS_MAINTENANCE_APPROVED=false
AI_GENERATION_ENABLED=false
AI_EXTERNAL_TRANSMISSION_APPROVED=false
GEO_WORKER_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://maimai.it.com/v1
AI_MODEL=gpt-6-sol
AI_REASONING_EFFORT=medium
AI_API_KEY=
# Future only; never point this at existing RDS during this preparation.
MYSQL_PRODUCTION_APPROVED=false
MYSQL_LOCAL_TEST_MODE=false
MYSQL_DATABASE_URL=
