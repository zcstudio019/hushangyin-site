generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerType {
  ENTERPRISE
  SELF_EMPLOYED
  PERSONAL
}

enum LeadStatus {
  NEW
  PENDING
  FOLLOWING
  COMPLETED
  INVALID
}

enum AdminRole {
  SUPER_ADMIN
  SALES_MANAGER
  FINANCING_ADVISOR
  CONTENT_OPERATOR
  CONTENT_REVIEWER
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

model Customer {
  id           String       @id @default(cuid())
  name         String       @db.VarChar(40)
  phone        String       @db.VarChar(11)
  customerType CustomerType
  companyName  String?      @db.VarChar(120)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  leads        Lead[]
  consents     Consent[]

  @@index([phone])
  @@map("customers")
}

model Lead {
  attribution      LeadAttribution?
  id               String           @id @default(cuid())
  customerId       String?
  customer         Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name             String           @db.VarChar(40)
  phone            String           @db.VarChar(11)
  customerType     CustomerType
  financingAmount  String           @db.VarChar(40)
  hasProperty      Boolean?
  hasCompany       Boolean?
  remark           String?          @db.VarChar(600)
  source           String           @default("website") @db.VarChar(40)
  sourcePage       String           @db.VarChar(200)
  sourceArticleId  String?
  sourceArticle    Article?         @relation(fields: [sourceArticleId], references: [id], onDelete: SetNull)
  sourceParameters Json?
  status           LeadStatus       @default(NEW)
  assignedTo       String?
  departmentId     String?
  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assignee         AdminUser?       @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  consents         Consent[]

  @@index([status, createdAt])
  @@index([assignedTo, createdAt])
  @@index([departmentId, createdAt])
  @@index([customerId])
  @@index([phone])
  @@index([updatedAt])
  @@index([sourceArticleId, createdAt])
  @@map("leads")
}

model AdminUser {
  analyticsConnections       SearchPlatformConnection[]
  analyticsJobs              AnalyticsSyncJob[]
  visibilityObservations     GeoVisibilityObservation[]
  assignedArticleReviews     Article[]                  @relation("ArticleReviewAssignee")
  assignedFaqReviews         Faq[]                      @relation("FaqReviewAssignee")
  submittedArticles          Article[]                  @relation("ArticleSubmitter")
  submittedFaqs              Faq[]                      @relation("FaqSubmitter")
  faqVersions                FaqVersion[]
  id                         String                     @id @default(cuid())
  name                       String                     @db.VarChar(80)
  email                      String                     @unique @db.VarChar(254)
  passwordHash               String                     @db.VarChar(255)
  role                       AdminRole                  @default(FINANCING_ADVISOR)
  departmentId               String?
  department                 Department?                @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  mustChangePassword         Boolean                    @default(false)
  sessionVersion             Int                        @default(0)
  initialCredentialExpiresAt DateTime?                  @db.Timestamptz(3)
  lastLoginAt                DateTime?                  @db.Timestamptz(3)
  isActive                   Boolean                    @default(true)
  createdAt                  DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                   @updatedAt @db.Timestamptz(3)
  leads                      Lead[]
  auditLogs                  AuditLog[]
  sessions                   AdminSession[]
  authoredArticles           Article[]                  @relation("ArticleAuthor")
  editedArticles             Article[]                  @relation("ArticleEditor")
  authoredFaqs               Faq[]                      @relation("FaqAuthor")
  editedFaqs                 Faq[]                      @relation("FaqEditor")
  articleVersions            ArticleVersion[]
  contentReviews             ContentReview[]
  generationTasks            GeoGenerationTask[]
  generationTemplates        GeoGenerationTemplate[]
  verifiedSources            ArticleSource[]            @relation("SourceVerifier")

  @@index([departmentId, role, isActive])
  @@map("admin_users")
}

model Department {
  id        String      @id @default(cuid())
  name      String      @unique @db.VarChar(80)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  users     AdminUser[]
  leads     Lead[]

  @@map("departments")
}

model AuditLog {
  id           String     @id @default(cuid())
  actorId      String?
  actor        AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String     @db.VarChar(60)
  resourceType String     @db.VarChar(40)
  resourceId   String?    @db.VarChar(64)
  metadata     Json?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Consent {
  id                String    @id @default(cuid())
  leadId            String?
  lead              Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  consentType       String    @db.VarChar(60)
  policyVersion     String    @db.VarChar(40)
  agreedAt          DateTime  @default(now()) @db.Timestamptz(3)
  evidenceReference String    @unique @db.VarChar(128)

  @@index([leadId])
  @@index([customerId])
  @@index([agreedAt])
  @@map("consents")
}

model Article {
  analyticsEvents        ContentEvent[]
  analyticsDays          ContentDailyMetric[]
  attributions           LeadAttribution[]
  visibilityObservations GeoVisibilityObservation[]
  reviewAssigneeId       String?
  reviewAssignee         AdminUser?                 @relation("ArticleReviewAssignee", fields: [reviewAssigneeId], references: [id], onDelete: SetNull)
  reviewAssignedRevision Int?
  reviewAssignedAt       DateTime?                  @db.Timestamptz(3)
  id                     String                     @id @default(cuid())
  title                  String                     @db.VarChar(200)
  slug                   String                     @unique @db.VarChar(160)
  summary                String                     @db.VarChar(600)
  content                String                     @db.Text
  category               String                     @db.VarChar(80)
  status                 ContentStatus              @default(DRAFT)
  publishedAt            DateTime?                  @db.Timestamptz(3)
  createdAt              DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                   @updatedAt @db.Timestamptz(3)
  tags                   String[]                   @default([])
  sources                Json                       @default("[]")
  contentFormat          String                     @default("MARKDOWN") @db.VarChar(20)
  authorId               String?
  author                 AdminUser?                 @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  editorId               String?
  editor                 AdminUser?                 @relation("ArticleEditor", fields: [editorId], references: [id], onDelete: SetNull)
  aiAssisted             Boolean                    @default(false)
  revision               Int                        @default(0)
  isLive                 Boolean                    @default(false)
  publishedSnapshot      Json?
  publishedRevision      Int?
  submittedAt            DateTime?                  @db.Timestamptz(3)
  submittedById          String?
  submittedBy            AdminUser?                 @relation("ArticleSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  seoTitle               String?                    @db.VarChar(200)
  metaDescription        String?                    @db.VarChar(600)
  generationMetadata     Json?
  complianceReport       Json?
  questionLinks          ArticleQuestionRelation[]
  faqLinks               ArticleFaqRelation[]
  sourceRecords          ArticleSource[]
  generationTask         GeoGenerationTask?
  versions               ArticleVersion[]
  reviews                ContentReview[]
  questions              GeoQuestion[]
  faqs                   Faq[]
  relatedFrom            ArticleRelation[]          @relation("RelatedFrom")
  relatedTo              ArticleRelation[]          @relation("RelatedTo")
  leads                  Lead[]

  @@index([status, publishedAt])
  @@index([status, submittedAt])
  @@index([reviewAssigneeId, status])
  @@index([isLive, publishedAt])
  @@index([category, status])
  @@index([authorId])
  @@map("articles")
}

model Faq {
  analyticsEvents        ContentEvent[]
  analyticsDays          ContentDailyMetric[]
  attributions           LeadAttribution[]
  reviewAssigneeId       String?
  reviewAssignee         AdminUser?           @relation("FaqReviewAssignee", fields: [reviewAssigneeId], references: [id], onDelete: SetNull)
  reviewAssignedRevision Int?
  reviewAssignedAt       DateTime?            @db.Timestamptz(3)
  id                     String               @id @default(cuid())
  question               String               @unique @db.VarChar(300)
  importMetadata         Json?
  answer                 String               @db.Text
  category               String               @db.VarChar(80)
  status                 ContentStatus        @default(DRAFT)
  createdAt              DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @db.Timestamptz(3)
  articleId              String?
  article                Article?             @relation(fields: [articleId], references: [id], onDelete: Restrict)
  sources                Json                 @default("[]")
  authorId               String?
  author                 AdminUser?           @relation("FaqAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  editorId               String?
  editor                 AdminUser?           @relation("FaqEditor", fields: [editorId], references: [id], onDelete: SetNull)
  revision               Int                  @default(0)
  isLive                 Boolean              @default(false)
  publishedAt            DateTime?            @db.Timestamptz(3)
  publishedSnapshot      Json?
  publishedRevision      Int?
  submittedAt            DateTime?            @db.Timestamptz(3)
  submittedById          String?
  submittedBy            AdminUser?           @relation("FaqSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  versions               FaqVersion[]
  articleLinks           ArticleFaqRelation[]
  reviews                ContentReview[]

  @@index([status, category])
  @@index([status, submittedAt])
  @@index([reviewAssigneeId, status])
  @@index([articleId, isLive])
  @@map("faqs")
}

enum SearchIntent {
  AWARENESS
  COMPARISON
  DECISION
  PREPARATION
}

enum QuestionStatus {
  OPEN
  PLANNED
  ANSWERED
  ARCHIVED
}

model GeoQuestion {
  id              String                    @id @default(cuid())
  question        String                    @unique @db.VarChar(300)
  importMetadata  Json?
  category        String                    @db.VarChar(80)
  keywords        String[]                  @default([])
  intent          SearchIntent              @default(AWARENESS)
  priority        Int                       @default(3)
  status          QuestionStatus            @default(OPEN)
  articleId       String?
  article         Article?                  @relation(fields: [articleId], references: [id], onDelete: Restrict)
  createdAt       DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @db.Timestamptz(3)
  articleLinks    ArticleQuestionRelation[]
  generationTasks GeoGenerationTask[]

  @@index([status, priority])
  @@index([category, intent])
  @@index([articleId])
  @@map("geo_questions")
}

enum GenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model GeoGenerationTemplate {
  id              String              @id @default(cuid())
  name            String              @unique @db.VarChar(100)
  description     String              @db.VarChar(600)
  templateContent String              @db.Text
  version         Int                 @default(1)
  isActive        Boolean             @default(true)
  updatedById     String?
  updatedBy       AdminUser?          @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  tasks           GeoGenerationTask[]

  @@map("geo_generation_templates")
}

model GeoGenerationTask {
  id                    String                @id @default(cuid())
  questionId            String
  question              GeoQuestion           @relation(fields: [questionId], references: [id], onDelete: Restrict)
  createdById           String
  createdBy             AdminUser             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  creatorSessionVersion Int
  status                GenerationStatus      @default(QUEUED)
  articleType           String                @db.VarChar(60)
  audience              String                @db.VarChar(120)
  depth                 String                @db.VarChar(30)
  templateId            String
  template              GeoGenerationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion       Int
  providerName          String                @db.VarChar(60)
  modelName             String                @db.VarChar(100)
  inputSnapshot         Json
  output                Json?
  outputArticleId       String?               @unique
  outputArticle         Article?              @relation(fields: [outputArticleId], references: [id], onDelete: SetNull)
  idempotencyKey        String                @db.VarChar(80)
  activeKey             String?               @unique @db.VarChar(64)
  attempts              Int                   @default(0)
  maxAttempts           Int                   @default(3)
  timeoutMs             Int                   @default(90000)
  maxOutputTokens       Int                   @default(4000)
  leaseToken            String?               @db.VarChar(64)
  leaseUntil            DateTime?             @db.Timestamptz(3)
  availableAt           DateTime              @default(now()) @db.Timestamptz(3)
  errorCode             String?               @db.VarChar(60)
  errorMessage          String?               @db.VarChar(400)
  tokenUsage            Json?
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  startedAt             DateTime?             @db.Timestamptz(3)
  completedAt           DateTime?             @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  callLogs              GenerationCallLog[]

  @@unique([createdById, idempotencyKey])
  @@index([status, availableAt])
  @@index([createdById, createdAt])
  @@index([questionId])
  @@index([leaseUntil])
  @@map("geo_generation_tasks")
}

model GenerationCallLog {
  id               String            @id @default(cuid())
  taskId           String
  task             GeoGenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attempt          Int
  provider         String            @db.VarChar(60)
  model            String            @db.VarChar(100)
  requestId        String?           @db.VarChar(120)
  status           String            @db.VarChar(40)
  errorCode        String?           @db.VarChar(60)
  usage            Json?
  estimatedCostUsd Decimal?          @db.Decimal(12, 6)
  startedAt        DateTime          @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?         @db.Timestamptz(3)

  @@unique([taskId, attempt])
  @@map("generation_call_logs")
}

model GenerationWorkerHeartbeat {
  id         String   @id @db.VarChar(80)
  lastSeenAt DateTime @db.Timestamptz(3)

  @@map("generation_worker_heartbeats")
}

model ArticleQuestionRelation {
  articleId    String
  article      Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  questionId   String
  question     GeoQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  relationType String      @default("RELATED") @db.VarChar(20)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)

  @@id([articleId, questionId])
  @@index([questionId])
  @@map("article_question_relations")
}

model ArticleFaqRelation {
  articleId    String
  article      Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  faqId        String
  faq          Faq     @relation(fields: [faqId], references: [id], onDelete: Restrict)
  revision     Int
  evidenceMode String  @db.VarChar(20)

  @@id([articleId, faqId])
  @@index([faqId])
  @@map("article_faq_relations")
}

model ArticleSource {
  id           String          @id @default(cuid())
  articleId    String?
  article      Article?        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  catalogId    String?
  catalog      ArticleSource?  @relation("CatalogBinding", fields: [catalogId], references: [id], onDelete: Restrict)
  bindings     ArticleSource[] @relation("CatalogBinding")
  title        String          @db.VarChar(200)
  sourceUrl    String          @db.VarChar(1000)
  sourceType   String          @default("REFERENCE") @db.VarChar(30)
  excerpt      String          @db.VarChar(4000)
  paragraph    String?         @db.VarChar(2000)
  verifiedAt   DateTime?       @db.Timestamptz(3)
  validUntil   DateTime?       @db.Timestamptz(3)
  verifiedById String?
  verifiedBy   AdminUser?      @relation("SourceVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  isActive     Boolean         @default(true)
  revision     Int?
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  @@index([articleId, revision])
  @@index([catalogId])
  @@index([isActive, verifiedAt])
  @@map("article_sources")
}

model ArticleVersion {
  id        String     @id @default(cuid())
  articleId String
  article   Article    @relation(fields: [articleId], references: [id], onDelete: Restrict)
  revision  Int
  snapshot  Json
  editorId  String?
  editor    AdminUser? @relation(fields: [editorId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([articleId, revision])
  @@map("article_versions")
}

model FaqVersion {
  id        String     @id @default(cuid())
  faqId     String
  faq       Faq        @relation(fields: [faqId], references: [id], onDelete: Restrict)
  revision  Int
  snapshot  Json
  editorId  String?
  editor    AdminUser? @relation(fields: [editorId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([faqId, revision])
  @@map("faq_versions")
}

model ArticleRelation {
  fromId String
  from   Article @relation("RelatedFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Article @relation("RelatedTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@index([toId])
  @@map("article_relations")
}

model ContentReview {
  id         String    @id @default(cuid())
  articleId  String?
  article    Article?  @relation(fields: [articleId], references: [id], onDelete: Restrict)
  faqId      String?
  faq        Faq?      @relation(fields: [faqId], references: [id], onDelete: Restrict)
  revision   Int
  reviewerId String
  reviewer   AdminUser @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  decision   String    @db.VarChar(20)
  checklist  Json
  note       String    @db.VarChar(1000)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([articleId, revision])
  @@unique([faqId, revision])
  @@index([reviewerId, createdAt])
  @@map("content_reviews")
}

model LoanProduct {
  id             String        @id @default(cuid())
  name           String        @unique @db.VarChar(160)
  category       String        @db.VarChar(80)
  targetCustomer String        @db.VarChar(300)
  description    String        @db.Text
  requirements   Json
  status         ContentStatus @default(DRAFT)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  @@index([status, category])
  @@map("loan_products")
}

// Supporting infrastructure; cookies hold only an encrypted opaque token.
model AdminSession {
  id             String    @id @default(cuid())
  tokenHash      String    @unique @db.VarChar(64)
  adminId        String
  sessionVersion Int       @default(0)
  admin          AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt      DateTime  @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model RateLimitBucket {
  key       String   @id @db.VarChar(100)
  count     Int      @default(1)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model SubmissionGuard {
  key       String   @id @db.VarChar(64)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("submission_guards")
}

// First-party opt-in measurement: no raw IP, full referrer, customer or device fingerprint.
model ContentEvent {
  id            String   @id @db.VarChar(64)
  dedupeKey     String   @unique @db.VarChar(64)
  type          String   @db.VarChar(20)
  articleId     String?
  article       Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  faqId         String?
  faq           Faq?     @relation(fields: [faqId], references: [id], onDelete: SetNull)
  contentKey    String   @db.VarChar(80)
  path          String   @db.VarChar(200)
  channel       String   @db.VarChar(20)
  sessionKey    String   @db.VarChar(64)
  policyVersion String   @db.VarChar(40)
  day           DateTime @db.Date
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([day, contentKey, type])
  @@index([sessionKey, contentKey, type])
  @@index([createdAt])
  @@map("content_events")
}

model ContentDailyMetric {
  id                    String   @id @default(cuid())
  day                   DateTime @db.Date
  contentKey            String   @db.VarChar(80)
  articleId             String?
  article               Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  faqId                 String?
  faq                   Faq?     @relation(fields: [faqId], references: [id], onDelete: SetNull)
  path                  String   @db.VarChar(200)
  channel               String   @db.VarChar(20)
  pv                    Int      @default(0)
  visits                Int      @default(0)
  clicks                Int      @default(0)
  convertedVisits       Int      @default(0) @map("measuredConsultations")
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  @@unique([day, contentKey, channel])
  @@index([articleId, day])
  @@index([faqId, day])
  @@map("content_daily_metrics")
}

model LeadAttribution {
  id           String   @id @default(cuid())
  leadId       String   @unique
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  articleId    String?
  article      Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  faqId        String?
  faq          Faq?     @relation(fields: [faqId], references: [id], onDelete: SetNull)
  sourceType   String   @db.VarChar(20)
  contentTitle String?  @db.VarChar(300)
  path         String   @db.VarChar(200)
  channel      String   @db.VarChar(20)
  confidence   String   @db.VarChar(40)
  utmSource    String?  @db.VarChar(40)
  utmMedium    String?  @db.VarChar(40)
  utmCampaign  String?  @db.VarChar(40)
  sessionKey   String?  @db.VarChar(64)
  measured     Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([articleId, createdAt])
  @@index([faqId, createdAt])
  @@index([channel, createdAt])
  @@map("lead_attributions")
}

model SearchPlatformConnection {
  id             String                    @id @default(cuid())
  platform       String                    @db.VarChar(20)
  siteUrl        String                    @db.VarChar(300)
  label          String                    @db.VarChar(100)
  isActive       Boolean                   @default(true)
  mode           String                    @default("CSV_ONLY") @db.VarChar(20)
  createdById    String?
  createdBy      AdminUser?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lastImportedAt DateTime?                 @db.Timestamptz(3)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @db.Timestamptz(3)
  metrics        SearchPerformanceMetric[]
  jobs           AnalyticsSyncJob[]

  @@unique([platform, siteUrl])
  @@map("search_platform_connections")
}

model SearchPerformanceMetric {
  id              String                   @id @default(cuid())
  connectionId    String
  connection      SearchPlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  day             DateTime                 @db.Date
  dimension       String                   @default("site-daily-web") @db.VarChar(30)
  clicks          Int
  impressions     Int
  averagePosition Float?
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)

  @@unique([connectionId, day, dimension])
  @@index([day])
  @@map("search_performance_metrics")
}

model GeoVisibilityObservation {
  id             String    @id @default(cuid())
  platform       String    @db.VarChar(60)
  query          String    @db.VarChar(300)
  observedOn     DateTime  @db.Date
  brandMention   Boolean
  siteCitation   Boolean
  recommendation Boolean
  articleId      String?
  article        Article?  @relation(fields: [articleId], references: [id], onDelete: SetNull)
  evidenceUrl    String    @db.VarChar(1000)
  evidenceNote   String    @db.VarChar(1500)
  actorId        String
  actor          AdminUser @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([observedOn, platform])
  @@index([articleId])
  @@map("geo_visibility_observations")
}

model AnalyticsSyncJob {
  id           String                   @id @default(cuid())
  connectionId String
  connection   SearchPlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  actorId      String?
  actor        AdminUser?               @relation(fields: [actorId], references: [id], onDelete: SetNull)
  kind         String                   @db.VarChar(20)
  status       String                   @db.VarChar(20)
  inputHash    String?                  @db.VarChar(64)
  result       Json?
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  completedAt  DateTime?                @db.Timestamptz(3)

  @@index([connectionId, createdAt])
  @@map("analytics_sync_jobs")
}
